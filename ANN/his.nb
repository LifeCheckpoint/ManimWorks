Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"HisDis", "[", 
   RowBox[{"n_", ",", "numSamples_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"samples", "=", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"numSamples", ",", "n"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"lengths", "=", 
       RowBox[{"Norm", "/@", "samples"}]}], ",", "filteredSamples"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"filteredSamples", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"samples", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Norm", "[", "#", "]"}], ">", "1"}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Histogram", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"ParallelTable", "[", 
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{
            RowBox[{"filteredSamples", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "-", 
            RowBox[{"filteredSamples", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "filteredSamples", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"i", "+", "1"}], ",", 
            RowBox[{"Length", "[", "filteredSamples", "]"}]}], "}"}]}], "]"}],
         "]"}], "\[IndentingNewLine]", ",", "20", ",", "\"\<Probability\>\"", 
       ",", 
       RowBox[{"ChartLegends", "->", 
        RowBox[{"{", "\"\<Distances\>\"", "}"}]}], ",", 
       RowBox[{"ChartLabels", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Distance\>\"", ",", "\"\<Probability Density\>\""}], 
         "}"}]}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
